# ─── DocChat Frontend Image — multi-stage ────────────────────────────────────
#
# Stage 1: build the React bundle with yarn (frozen lockfile).
# Stage 2: serve the static bundle through Nginx with SSE-friendly config.

# ──────────────────────────────── Builder ────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy ONLY the lockfile + package.json first so the install layer caches
# until you change dependencies.
COPY frontend/package.json frontend/yarn.lock /app/

# `--frozen-lockfile` is mandatory: the build must use the exact versions
# recorded in yarn.lock. NEVER let yarn silently bump deps in CI.
RUN yarn install --frozen-lockfile

# Now bring in the source and produce a static bundle.
COPY frontend/public/ /app/public/
COPY frontend/src/    /app/src/
COPY frontend/tailwind.config.js frontend/postcss.config.js frontend/craco.config.js frontend/jsconfig.json /app/

# Inject the public backend URL at build time. Compose will pass --build-arg.
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL

RUN yarn build

# ──────────────────────────────── Runner ─────────────────────────────────────
FROM nginx:1.25-alpine AS runner

# Replace the stock Nginx config with our SSE-aware one.
RUN rm -rf /etc/nginx/conf.d/default.conf
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# Drop the bundle into the default web root.
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
