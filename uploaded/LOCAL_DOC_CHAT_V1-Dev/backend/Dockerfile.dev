# ============================================================================
# DocChat Backend - Development Dockerfile (hot-reload enabled)
# ============================================================================
# Single-stage, optimized for iteration speed. Source code is bind-mounted
# by docker-compose.dev.yml; uvicorn --reload watches for changes.
# ============================================================================

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/backend \
    UPLOAD_DIR=/app/backend/uploads \
    CHROMA_DIR=/app/backend/chroma_db

# Build + runtime deps together (keeps dev image simple)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        libffi-dev \
        libssl-dev \
        libxml2-dev \
        libxslt1-dev \
        libjpeg-dev \
        zlib1g-dev \
        tesseract-ocr \
        tesseract-ocr-eng \
        poppler-utils \
        libmagic1 \
        libgl1 \
        libglib2.0-0 \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel \
 && pip install -r requirements.txt

# Source is bind-mounted at runtime; copy here too so the image works standalone
COPY . /app/backend

RUN mkdir -p /app/backend/uploads /app/backend/chroma_db

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8001/api/health || exit 1

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--reload", "--reload-dir", "/app/backend"]
