*.db

# Secrets
.env
.env.*
!.env.example

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git / CI
.git/
.gitignore
.github/

# Tests & docs that aren't needed at runtime
tests/
*.md
!README.md

# Docker artifacts (avoid recursion)
Dockerfile*
.dockerignore
docker-compose*.yml
